# API Qiryna — serveur uniquement, jamais exposée au navigateur.
NUXT_API_BASE_URL=https://admin.stage.qiryna.com/api

# Durée de vie du cache catalogue côté Nitro, en secondes.
NUXT_CATALOG_CACHE_TTL=300

# Délai maximal d'un appel à l'API, en millisecondes.
NUXT_API_TIMEOUT=15000

# URL publique du site — sert à générer les balises hreflang/canonical
# (`useLocaleHead`). Sans elle, @nuxtjs/i18n avertit et ces balises sont incomplètes.
NUXT_PUBLIC_SITE_URL=https://web.qiryna.com

# ─── OAuth ──────────────────────────────────────────────────────────────
# Identifiants CLIENTS des fournisseurs tiers. Publics par nature : ils
# apparaissent dans l'URL d'autorisation ouverte par le navigateur. Les secrets
# correspondants restent côté back-office, qui valide les jetons.
#
# Laissé vide = fournisseur désactivé (bouton grisé), aucun appel n'est tenté.
# Aucun de ces identifiants n'est fourni sur l'environnement de recette.
#
# Ces identifiants doivent être ceux d'une application enregistrée dans la
# console de chaque fournisseur (Google Cloud Console / Meta for Developers /
# LinkedIn Developers) — voir qiryna-backoffice/docs/OAUTH_SETUP.md pour le
# pas-à-pas. Le back-office valide le jeton reçu via ce même client (Laravel
# Socialite, `config/services.php` → GOOGLE_CLIENT_ID/FACEBOOK_CLIENT_ID/
# LINKEDIN_CLIENT_ID côté serveur) : les valeurs ci-dessous doivent être
# celles de la MÊME application, pas une nouvelle créée séparément.
#
# Google : Authorized JavaScript origins = le domaine du site (front), pas de
# redirect URI nécessaire (flux par jeton, pop-up).
# Facebook : Site URL / App Domains = le domaine du site (flux SDK, pop-up).
# LinkedIn : Authorized redirect URLs — le SEUL des trois à utiliser une vraie
# redirection ; ajouter EXACTEMENT ces chemins du front (pas ceux du
# back-office) :
#   {domaine}/connexion
#   {domaine}/inscription
#   {domaine}/en/connexion
#   {domaine}/en/inscription
NUXT_PUBLIC_OAUTH_GOOGLE_CLIENT_ID=
NUXT_PUBLIC_OAUTH_FACEBOOK_APP_ID=
NUXT_PUBLIC_OAUTH_LINKEDIN_CLIENT_ID=
