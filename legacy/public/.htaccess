# =============================================================================
# qiryna.com — configuration Apache (front SPA Vue)
# Ce fichier est copié à la racine de dist/ au build (publicDir Vite) puis
# déployé dans le docroot Apache.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) RESTRICTION D'ACCÈS PAR IP + PAGE « COMING SOON »
# -----------------------------------------------------------------------------
# Quand la restriction est active, les visiteurs non autorisés voient
# maintenance.html (page « Bientôt disponible ») au lieu d'un 403 brut.
#
# Apache 2.4+ requis (directive "Require ip").
#
# La restriction est PILOTÉE DEPUIS LE BACK-OFFICE (Paramètres → Clés &
# Intégrations : ip_restriction_enabled + allowed_ips). À chaque sauvegarde, le
# back-office régénère le bloc QIRYNA-IP-GATE ci-dessous (commande équivalente :
# `php artisan qiryna:sync-ip-gate`). Aucun rebuild/déploiement nécessaire.
#
# ⚠️ Le bloc entre les marqueurs est GÉRÉ AUTOMATIQUEMENT : ne l'éditez pas à la
#    main, il serait écrasé à la prochaine sauvegarde des réglages.
# >>> QIRYNA-IP-GATE >>>
# Restriction désactivée (état par défaut au déploiement). NE PAS éditer à la main.
# <<< QIRYNA-IP-GATE <<<

# Sert la page « Coming soon » à la place du 403 par défaut.
ErrorDocument 403 /maintenance.html

# La page de maintenance et ses assets restent TOUJOURS accessibles, même pour
# les IP bloquées (sinon ErrorDocument afficherait une page cassée / une boucle).
<FilesMatch "^(maintenance\.html|qiryna-logo\.png|favicon\.ico|favicon\.png)$">
    Require all granted
</FilesMatch>

# -----------------------------------------------------------------------------
# 2) FALLBACK SPA — toutes les routes renvoient index.html
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ne pas réécrire les fichiers/dossiers réels (assets, images, sitemap…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Tout le reste → index.html (routage côté client Vue Router)
    RewriteRule ^ index.html [L]
</IfModule>

# -----------------------------------------------------------------------------
# 3) EN-TÊTES DE SÉCURITÉ HTTP
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS : à activer seulement une fois le HTTPS confirmé partout
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# -----------------------------------------------------------------------------
# 4) CACHE DES ASSETS STATIQUES (perf)
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    # Ne pas mettre index.html en cache long (déploiements)
    <FilesMatch "index\.html$">
        ExpiresByType text/html "access plus 0 seconds"
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
